{
  "name": "oficiosya",
  "version": "1.0.0",
  "private": true,
  "description": "Comandos comunes del frontend y backend de OficiosYa",
  "engines": { "node": ">=22.20.0" },
  "scripts": {
    "setup": "npm --prefix backend ci && npm --prefix frontend ci",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev -- --configLoader native",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build -- --configLoader native",
    "test:backend": "npm --prefix backend test",
    "test:frontend": "npm --prefix frontend run test:e2e",
    "preview": "npm --prefix frontend run preview -- --host 127.0.0.1 --port 5173 --configLoader native"
  }
}
